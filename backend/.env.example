# ClaimWise AI — Backend Environment Variables
# Copy this file to .env and fill in real values for local development.
# Never commit .env to source control.

# ── DynamoDB ──────────────────────────────────────────────────────────────────
CLAIMS_TABLE_NAME=ClaimwiseClaims
EVIDENCE_TABLE_NAME=ClaimwiseEvidence

# ── S3 ────────────────────────────────────────────────────────────────────────
EVIDENCE_BUCKET_NAME=claimwise-evidence-dev

# ── Pre-signed URL ────────────────────────────────────────────────────────────
# Time-to-live for S3 pre-signed upload URLs, in seconds (default: 900 = 15 min)
PRESIGNED_URL_EXPIRY_SECONDS=900

# ── File size limits (bytes) ──────────────────────────────────────────────────
MAX_FILE_SIZE_VIDEO_BYTES=524288000       # 500 MB
MAX_FILE_SIZE_AUDIO_BYTES=52428800        # 50 MB
MAX_FILE_SIZE_POLICY_DOCUMENT_BYTES=10485760  # 10 MB

# ── Cognito ───────────────────────────────────────────────────────────────────
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
